[flake8]
exclude = 
    .claude/,
    .git/,
    __pycache__/,
    *.pyc,
    *.pyo,
    *.pyd,
    .Python,
    env/,
    pip-log.txt,
    pip-delete-this-directory.txt,
    .tox/,
    .coverage,
    .coverage.*,
    .cache,
    nosetests.xml,
    coverage.xml,
    *.cover,
    *.log,
    .git/,
    .mypy_cache/,
    .pytest_cache/,
    .hypothesis/
max-line-length = 88
extend-ignore = E203, W503
